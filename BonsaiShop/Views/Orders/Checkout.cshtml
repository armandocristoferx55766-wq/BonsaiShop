
@model BonsaiShop.Models.CheckoutViewModel

@{
    ViewBag.Title = "Xác nhận đơn hàng";
}

<style>
    .checkout-title {
        color: #245c36;
        font-weight: bold;
        margin: 30px 0;
    }

    .checkout-box {
        background: #f5f8f3;
        border-radius: 12px;
        padding: 22px;
        margin-bottom: 20px;
    }

        .checkout-box h5 {
            color: #245c36;
            font-weight: bold;
            margin-bottom: 18px;
        }

    .checkout-total {
        color: #dc3545;
        font-weight: bold;
    }

    .order-btn {
        background: #245c36;
        color: white;
        border: none;
        padding: 11px 25px;
        border-radius: 7px;
        font-weight: bold;
        transition: 0.3s;
    }

        .order-btn:hover {
            background: #174326;
            color: white;
        }
</style>

<div class="container mt-4 mb-5">

    <h2 class="checkout-title">XÁC NHẬN ĐƠN HÀNG</h2>

    <div class="row">

        <!-- THÔNG TIN GIAO HÀNG -->
        <div class="col-md-5">

            <div class="checkout-box">

                <h5>Thông tin người nhận</h5>

                <div class="mb-3">
                    <label class="form-label fw-bold">Họ và tên</label>
                    <input type="text"
                           class="form-control"
                           value="@Model.FullName"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Số điện thoại</label>
                    <input type="text"
                           class="form-control"
                           value="@Model.Phone"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Địa chỉ giao hàng</label>
                    <textarea class="form-control"
                              rows="3"
                              readonly>@Model.Address</textarea>
                </div>

                <p class="text-muted mb-0">
                    Thông tin giao hàng được lấy từ tài khoản của bạn.
                </p>

            </div>

        </div>

        <!-- DANH SÁCH SẢN PHẨM -->
        <div class="col-md-7">

            <div class="checkout-box">

                <h5>Đơn hàng của bạn</h5>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.CartItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>

                                    <td class="text-center">
                                        @item.Quantity
                                    </td>

                                    <td class="text-end">
                                        @String.Format("{0:N0} VNĐ", item.Total)
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">Tổng thanh toán</h5>

                    <h4 class="checkout-total mb-0">
                        @String.Format("{0:N0} VNĐ", Model.GrandTotal)
                    </h4>

                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <a href="@Url.Action("Index", "Cart")"
                       class="btn btn-outline-secondary">
                        Quay lại giỏ hàng
                    </a>

                    @using (Html.BeginForm("PlaceOrder", "Orders", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit" class="order-btn">
                            <i class="bi bi-bag-check"></i>
                            Đặt hàng
                        </button>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
