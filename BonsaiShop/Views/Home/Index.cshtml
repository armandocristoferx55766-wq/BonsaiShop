
@model IEnumerable<BonsaiShop.Product>

@{
    ViewBag.Title = "Trang chủ";
}

<style>
    .hero-section {
        background: linear-gradient(120deg, #153d2b, #367b4d);
        color: white;
        padding: 65px 35px;
        border-radius: 15px;
        margin-bottom: 40px;
    }

        .hero-section h1 {
            font-size: 38px;
            font-weight: bold;
        }

        .hero-section p {
            font-size: 17px;
            margin-top: 15px;
        }

    .section-title {
        color: #245c38;
        font-weight: bold;
        margin-bottom: 25px;
    }

    /* DANH MỤC */
    .category-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        height: 100%;
        background: white;
        transition: 0.3s;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        text-align: center;
        padding: 28px 15px;
    }

        .category-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

    .category-icon {
        width: 105px;
        height: 105px;
        border-radius: 50%;
        background: #edf5ee;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        font-size: 55px;
    }

    .category-card h5 {
        color: #245c38;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .category-card p {
        color: #777;
        font-size: 14px;
        min-height: 42px;
    }

    .category-btn {
        background: #287a43;
        color: white;
        border-radius: 7px;
        padding: 8px 22px;
    }

        .category-btn:hover {
            background: #195b30;
            color: white;
        }

    /* SẢN PHẨM */
    .product-card {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        transition: 0.3s;
        height: 100%;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

    .product-image {
        height: 220px;
        width: 100%;
        object-fit: cover;
        background: #f1f5f1;
    }

    .product-name {
        font-size: 18px;
        font-weight: bold;
        color: #245c38;
    }

    .product-price {
        color: #dc3545;
        font-size: 19px;
        font-weight: bold;
    }

    .category-name {
        color: #777;
        font-size: 14px;
    }

    .btn-bonsai {
        background: #287a43;
        color: white;
        border-radius: 7px;
    }

        .btn-bonsai:hover {
            background: #195b30;
            color: white;
        }
</style>

<div class="container mt-4">

    <!-- BANNER -->
    <section class="hero-section">
        <div class="row align-items-center">

            <div class="col-md-8">

                <h5 class="mb-2" style="letter-spacing: 3px;">
                    CHÀO MỪNG ĐẾN VỚI
                </h5>

                <h1 class="fw-bold">
                    BONSAI SHOP
                </h1>

                <h4 class="mt-3">
                    Vẻ đẹp thiên nhiên – Nghệ thuật từ tâm
                </h4>

                <p>
                    Khám phá những tác phẩm bonsai độc đáo,
                    mang nét đẹp tinh tế và sức sống thiên nhiên
                    đến không gian của bạn.
                </p>

                <a href="#categories" class="btn btn-light mt-3">
                    Khám phá danh mục
                </a>

            </div>

            <div class="col-md-4 text-center">
                <div style="font-size: 110px;">🌳</div>
            </div>

        </div>
    </section>

    <!-- GIỚI THIỆU -->
    <div class="text-center mb-5">

        <h2 class="section-title">
            BONSAI NGHỆ THUẬT
        </h2>

        <p class="text-muted">
            Những tác phẩm bonsai độc đáo, mang vẻ đẹp thiên nhiên đến ngôi nhà của bạn.
        </p>

    </div>

    <!-- DANH MỤC SẢN PHẨM -->
    <section id="categories" class="mb-5">

        <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

            <h3 class="section-title mb-0">
                DANH MỤC SẢN PHẨM
            </h3>

            @if (Session["Role"] != null &&
                 Session["Role"].ToString() == "Admin")
            {
                <a href="@Url.Action("Index", "Categories")"
                   class="btn btn-success">
                    <i class="bi bi-gear"></i>
                    Quản lý danh mục
                </a>
            }

        </div>

        <div class="row g-4">

            @if (ViewBag.Categories != null &&
                 ((IEnumerable<BonsaiShop.Category>)ViewBag.Categories).Any())
            {
                foreach (var category in
                    (IEnumerable<BonsaiShop.Category>)ViewBag.Categories)
                {
                    string icon = "🌱";
                    string description = "Khám phá các sản phẩm trong danh mục.";

                    if (category.CategoryName.Contains("Bonsai"))
                    {
                        icon = "🌳";
                        description = "Những cây bonsai nghệ thuật độc đáo và tinh tế.";
                    }
                    else if (category.CategoryName.Contains("Chậu"))
                    {
                        icon = "🪴";
                        description = "Các mẫu chậu đẹp, phù hợp với nhiều dáng bonsai.";
                    }
                    else if (category.CategoryName.Contains("Dụng cụ"))
                    {
                        icon = "✂️";
                        description = "Dụng cụ chăm sóc và tạo dáng bonsai chuyên dụng.";
                    }
                    else if (category.CategoryName.Contains("Phân bón"))
                    {
                        icon = "🌱";
                        description = "Sản phẩm hỗ trợ cây phát triển khỏe mạnh.";
                    }

                    <div class="col-lg-3 col-md-6 col-sm-6">

                        <div class="category-card">

                            <div class="category-icon">
                                @icon
                            </div>

                            <h5>
                                @category.CategoryName
                            </h5>

                            <p>
                                @(string.IsNullOrWhiteSpace(category.Description)
                                    ? description
                                    : category.Description)
                            </p>

                            <a href="@Url.Action("Index", "Products",
                                new { categoryId = category.CategoryID })"
                               class="btn category-btn">
                                Xem sản phẩm
                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info text-center">
                        Hiện chưa có danh mục sản phẩm nào.
                    </div>
                </div>
            }

        </div>

    </section>

    <!-- SẢN PHẨM NỔI BẬT -->
    <section id="products">

        <h3 class="section-title">
            SẢN PHẨM NỔI BẬT
        </h3>

        <div class="row g-4">

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6">

                        <div class="card product-card shadow-sm">

                            @if (!string.IsNullOrWhiteSpace(item.Image))
                            {
                                <img src="@Url.Content(item.Image)"
                                     class="product-image"
                                     alt="@item.ProductName" />
                            }
                            else
                            {
                                <div class="product-image d-flex align-items-center justify-content-center">
                                    <span style="font-size: 65px;">🌳</span>
                                </div>
                            }

                            <div class="card-body">

                                <div class="category-name mb-2">
                                    @(item.Category != null
                                        ? item.Category.CategoryName
                                        : "Bonsai")
                                </div>

                                <h5 class="product-name">
                                    @item.ProductName
                                </h5>

                                <p class="product-price">
                                    @item.Price.ToString("N0") VNĐ
                                </p>

                                <p class="text-muted">
                                    Số lượng: @item.Quantity
                                </p>

                                <a href="@Url.Action("Details", "Products",
                                    new { id = item.ProductID })"
                                   class="btn btn-bonsai w-100">
                                    Xem chi tiết
                                </a>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="alert alert-info">
                        Hiện chưa có sản phẩm nào được đăng bán.
                    </div>
                </div>
            }

        </div>

    </section>

    <!-- ƯU ĐIỂM -->
    <section class="row mt-5 mb-4 text-center">

        <div class="col-md-4 mb-3">
            <h2>🌱</h2>
            <h5>Chất lượng</h5>
            <p class="text-muted">
                Sản phẩm bonsai được tuyển chọn kỹ lưỡng.
            </p>
        </div>

        <div class="col-md-4 mb-3">
            <h2>🚚</h2>
            <h5>Giao hàng</h5>
            <p class="text-muted">
                Hỗ trợ giao hàng tận nơi cho khách hàng.
            </p>
        </div>

        <div class="col-md-4 mb-3">
            <h2>💚</h2>
            <h5>Tận tâm</h5>
            <p class="text-muted">
                Luôn đồng hành cùng khách hàng yêu bonsai.
            </p>
        </div>

    </section>

</div>
