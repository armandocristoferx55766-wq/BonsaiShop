
@{
    ViewBag.Title = "Đăng nhập";
}

<style>
    .login-container {
        max-width: 500px;
        margin: 50px auto;
    }

    .login-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .login-header {
        background: #245c36;
        color: white;
        padding: 25px;
        text-align: center;
    }

    .login-body {
        padding: 30px;
    }

    .form-label {
        color: #245c36;
        font-weight: 600;
    }

    .btn-login {
        background: #245c36;
        color: white;
        width: 100%;
        padding: 12px;
        font-weight: bold;
    }

        .btn-login:hover {
            background: #194529;
            color: white;
        }
</style>

<div class="container login-container">

    <div class="card shadow login-card">

        <div class="login-header">
            <h2 class="fw-bold">ĐĂNG NHẬP</h2>
            <p class="mb-0">Em Không Sai, Bonsai</p>
        </div>

        <div class="login-body">

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email"
                           name="email"
                           class="form-control"
                           placeholder="Nhập email của bạn"
                           required />
                </div>

                <div class="mb-4">
                    <label class="form-label">Mật khẩu</label>
                    <input type="password"
                           name="password"
                           class="form-control"
                           placeholder="Nhập mật khẩu"
                           required />
                </div>

                <button type="submit" class="btn btn-login">
                    ĐĂNG NHẬP
                </button>

                <div class="text-center mt-3">
                    Chưa có tài khoản?
                    <a href="@Url.Action("Register", "Account")"
                       class="text-success fw-bold">
                        Đăng ký ngay
                    </a>
                </div>
            }

        </div>
    </div>
</div>
