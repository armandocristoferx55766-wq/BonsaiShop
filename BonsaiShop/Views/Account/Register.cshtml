
@model BonsaiShop.User

@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<style>
    .register-container {
        max-width: 650px;
        margin: 40px auto;
    }

    .register-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .register-header {
        background: #245c36;
        color: white;
        padding: 25px;
        text-align: center;
    }

    .register-body {
        padding: 30px;
    }

    .form-label {
        color: #245c36;
        font-weight: 600;
    }

    .btn-register {
        background: #245c36;
        color: white;
        width: 100%;
        padding: 12px;
        font-weight: bold;
    }

        .btn-register:hover {
            background: #194529;
            color: white;
        }

    .field-validation-error {
        color: red;
        font-size: 13px;
    }
</style>

<div class="container register-container">
    <div class="card shadow register-card">

        <div class="register-header">
            <h2 class="fw-bold">ĐĂNG KÝ TÀI KHOẢN</h2>
            <p class="mb-0">Chào mừng bạn đến với Em Không Sai, Bonsai</p>
        </div>

        <div class="register-body">

            @using (Html.BeginForm("Register", "Account", FormMethod.Post,
                new { id = "registerForm" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="mb-3">
                    <label class="form-label">Họ và tên</label>
                    @Html.TextBoxFor(m => m.FullName,
                             new { @class = "form-control", placeholder = "Nhập họ và tên" })
                    @Html.ValidationMessageFor(m => m.FullName)
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    @Html.TextBoxFor(m => m.Email,
                             new { @class = "form-control", type = "email", placeholder = "Nhập email" })
                    @Html.ValidationMessageFor(m => m.Email)
                </div>

                <div class="mb-3">
                    <label class="form-label">Mật khẩu</label>
                    @Html.PasswordFor(m => m.PasswordHash,
                             new { @class = "form-control", placeholder = "Nhập mật khẩu" })
                    @Html.ValidationMessageFor(m => m.PasswordHash)
                </div>

                <div class="mb-3">
                    <label class="form-label">Số điện thoại</label>
                    @Html.TextBoxFor(m => m.Phone,
                             new
                             {
                                 @class = "form-control",
                                 type = "tel",
                                 maxlength = "10",
                                 placeholder = "Nhập số điện thoại"
                             })
                    @Html.ValidationMessageFor(m => m.Phone)
                </div>

                <hr />

                <h5 class="fw-bold mb-3" style="color:#245c36">
                    <i class="bi bi-geo-alt"></i> Địa chỉ nhận hàng
                </h5>

                <div class="mb-3">
                    <label class="form-label">Tỉnh / Thành phố</label>
                    <select id="province" class="form-select" required>
                        <option value="">Đang tải tỉnh/thành phố...</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Xã / Phường</label>
                    <select id="ward" class="form-select" disabled required>
                        <option value="">Vui lòng chọn tỉnh/thành phố trước</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label">Địa chỉ nhà</label>
                    <input type="text"
                           id="houseAddress"
                           class="form-control"
                           placeholder="Số nhà, tên đường, thôn/xóm..."
                           required />
                    @Html.HiddenFor(m => m.Address, new { id = "Address" })
                    @Html.ValidationMessageFor(m => m.Address)
                </div>

                <button type="submit" class="btn btn-register">
                    ĐĂNG KÝ
                </button>

                <div class="text-center mt-3">
                    Đã có tài khoản?
                    <a href="@Url.Action("Login", "Account")"
                       class="text-success fw-bold">
                        Đăng nhập
                    </a>
                </div>
            }

        </div>
    </div>
</div>

<script>const provinceSelect = document.getElementById("province");
    const wardSelect = document.getElementById("ward");

    // Tải danh sách tỉnh/thành phố
    fetch("https://provinces.open-api.vn/api/v2/p/")
        .then(response => {
            if (!response.ok) throw new Error("Không tải được tỉnh/thành phố");
            return response.json();
        })
        .then(data => {
            provinceSelect.innerHTML =
                '<option value="">-- Chọn tỉnh/thành phố --</option>';

            data.sort((a, b) => a.name.localeCompare(b.name, "vi"));

            data.forEach(province => {
                const option = document.createElement("option");
                option.value = province.code;
                option.textContent = province.name;
                provinceSelect.appendChild(option);
            });
        })
        .catch(error => {
            provinceSelect.innerHTML =
                '<option value="">Không tải được dữ liệu. Vui lòng tải lại trang.</option>';
            console.error(error);
        });

    // Khi chọn tỉnh/thành phố, tải danh sách xã/phường tương ứng
    provinceSelect.addEventListener("change", function () {
        const provinceCode = this.value;

        wardSelect.innerHTML =
            '<option value="">Đang tải xã/phường...</option>';
        wardSelect.disabled = true;

        if (!provinceCode) {
            wardSelect.innerHTML =
                '<option value="">Vui lòng chọn tỉnh/thành phố trước</option>';
            return;
        }

        fetch("https://provinces.open-api.vn/api/v2/w/?province=" + provinceCode)
            .then(response => {
                if (!response.ok) throw new Error("Không tải được xã/phường");
                return response.json();
            })
            .then(data => {
                wardSelect.innerHTML =
                    '<option value="">-- Chọn xã/phường --</option>';

                data.sort((a, b) => a.name.localeCompare(b.name, "vi"));

                data.forEach(ward => {
                    const option = document.createElement("option");
                    option.value = ward.code;
                    option.textContent = ward.name;
                    wardSelect.appendChild(option);
                });

                wardSelect.disabled = false;
            })
            .catch(error => {
                wardSelect.innerHTML =
                    '<option value="">Không tải được xã/phường</option>';
                console.error(error);
            });
    });

    // Ghép địa chỉ thành một chuỗi trước khi gửi biểu mẫu
    document.getElementById("registerForm").addEventListener("submit", function (event) {
        const provinceName =
            provinceSelect.options[provinceSelect.selectedIndex]?.text;

        const wardName =
            wardSelect.options[wardSelect.selectedIndex]?.text;

        const houseAddress =
            document.getElementById("houseAddress").value.trim();

        if (!provinceSelect.value || !wardSelect.value || !houseAddress) {
            event.preventDefault();
            alert("Vui lòng chọn đầy đủ tỉnh/thành phố, xã/phường và nhập địa chỉ nhà!");
            return;
        }

        document.getElementById("Address").value =
            houseAddress + ", " + wardName + ", " + provinceName;
    });</script>
