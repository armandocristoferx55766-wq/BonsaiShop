
@model BonsaiShop.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
}

<style>
    .detail-container {
        margin-top: 40px;
        margin-bottom: 50px;
    }

    .product-image {
        width: 100%;
        height: 420px;
        object-fit: contain;
        background: #f5f8f3;
        border-radius: 15px;
        padding: 15px;
    }

    .product-info {
        padding: 25px;
    }

    .product-name {
        color: #245c36;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .product-price {
        color: #dc3545;
        font-size: 28px;
        font-weight: bold;
    }

    .product-description {
        line-height: 1.8;
        color: #555;
    }

    .detail-label {
        font-weight: bold;
        color: #245c36;
    }
</style>

<div class="container detail-container">

    <div class="row shadow-sm rounded-4 p-3">

        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="@Url.Content(Model.Image)"
                     class="product-image"
                     alt="@Model.ProductName" />
            }
            else
            {
                <div class="product-image d-flex align-items-center justify-content-center">
                    <span class="text-muted">Chưa có hình ảnh sản phẩm</span>
                </div>
            }
        </div>

        <div class="col-md-6 product-info">

            <h2 class="product-name">@Model.ProductName</h2>

            <p class="product-price">
                @String.Format("{0:N0} VNĐ", Model.Price)
            </p>

            <hr />

            <p>
                <span class="detail-label">Danh mục:</span>
                @(Model.Category != null ? Model.Category.CategoryName : "Chưa phân loại")
            </p>

            <p>
                <span class="detail-label">Số lượng còn:</span>
                @Model.Quantity
            </p>

            <p class="detail-label">Mô tả sản phẩm:</p>

            <p class="product-description">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "Chưa có mô tả cho sản phẩm này."
                    : Model.Description)
            </p>

            <hr />

            @if (Model.Quantity > 0)
             {
                <a href="@Url.Action("AddToCart", "Cart",
                    new { id = Model.ProductID })"
                   class="btn btn-success me-2">
                    <i class="bi bi-cart-plus"></i>
                    Thêm vào giỏ hàng
                </a>
             }
            else
            {
                <button class="btn btn-secondary me-2" disabled>
                    Hết hàng
                </button>
            }

            <a href="@Url.Action("Index", "Home")"
               class="btn btn-success">
                Quay lại trang chủ
            </a>

            <a href="@Url.Action("Index", "Products")"
               class="btn btn-outline-success">
                Danh sách sản phẩm
            </a>

        </div>
    </div>
</div>
