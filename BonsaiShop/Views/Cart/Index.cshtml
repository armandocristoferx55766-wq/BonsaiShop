
@model List<BonsaiShop.Models.CartItem>

@{
    ViewBag.Title = "Giỏ hàng";
    decimal grandTotal = Model == null ? 0 : Model.Sum(item => item.Total);
}

<style>
    .cart-title {
        color: #245c36;
        font-weight: bold;
        margin: 30px 0;
    }

    .cart-image {
        width: 85px;
        height: 85px;
        object-fit: contain;
        border-radius: 10px;
        background: #f5f8f3;
        padding: 5px;
    }

    .cart-table th {
        background: #245c36;
        color: white;
        vertical-align: middle;
        text-align: center;
    }

    .cart-table td {
        vertical-align: middle;
    }

    .total-box {
        background: #f5f8f3;
        padding: 20px;
        border-radius: 12px;
    }

    .quantity-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        font-weight: bold;
    }

    .checkout-btn {
        background: #245c36;
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 7px;
        font-weight: bold;
        text-decoration: none;
        display: inline-block;
        transition: 0.3s;
    }

        .checkout-btn:hover {
            background: #173d2b;
            color: white;
        }
</style>

<div class="container mt-4 mb-5">

    <h2 class="cart-title">GIỎ HÀNG CỦA BẠN</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center p-4">
            <h5>Giỏ hàng của bạn đang trống!</h5>

            <p>Hãy chọn những cây bonsai yêu thích nhé.</p>

            <a href="@Url.Action("Index", "Home")"
               class="btn btn-success">
                Tiếp tục mua sắm
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered align-middle cart-table">

                <thead>
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.Image))
                                {
                                    <img src="@Url.Content(item.Image)"
                                         class="cart-image"
                                         alt="@item.ProductName" />
                                }
                                else
                                {
                                    <span>Chưa có ảnh</span>
                                }
                            </td>

                            <td>
                                <strong>@item.ProductName</strong>
                            </td>

                            <td class="text-center">
                                @String.Format("{0:N0} VNĐ", item.Price)
                            </td>

                            <td class="text-center">

                                <div class="d-flex justify-content-center align-items-center gap-2">

                                    <a href="@Url.Action("UpdateQuantity", "Cart",
                                        new { id = item.ProductID, quantity = item.Quantity - 1 })"
                                       class="btn btn-outline-secondary btn-sm quantity-btn">
                                        -
                                    </a>

                                    <span class="fw-bold">
                                        @item.Quantity
                                    </span>

                                    <a href="@Url.Action("UpdateQuantity", "Cart",
                                        new { id = item.ProductID, quantity = item.Quantity + 1 })"
                                       class="btn btn-outline-success btn-sm quantity-btn">
                                        +
                                    </a>

                                </div>

                            </td>

                            <td class="text-danger fw-bold text-center">
                                @String.Format("{0:N0} VNĐ", item.Total)
                            </td>

                            <td class="text-center">

                                <a href="@Url.Action("RemoveFromCart", "Cart",
                                    new { id = item.ProductID })"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                    Xóa
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- TỔNG TIỀN VÀ THANH TOÁN -->
        <div class="row justify-content-end mt-4">

            <div class="col-md-5">

                <div class="total-box">

                    <h5>Tổng thanh toán</h5>

                    <h3 class="text-danger fw-bold">
                        @String.Format("{0:N0} VNĐ", grandTotal)
                    </h3>

                    <hr />

                    <div class="d-flex flex-wrap gap-2">

                        <a href="@Url.Action("Index", "Home")"
                           class="btn btn-outline-success">
                            Tiếp tục mua sắm
                        </a>

                        <a href="@Url.Action("Checkout", "Orders")"
                           class="checkout-btn">
                            <i class="bi bi-credit-card"></i>
                            Thanh toán
                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>
